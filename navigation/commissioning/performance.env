# This wheelchair's tested performance cores and local environment settings.
# The launcher and its children inherit the CPU affinity; sensor drivers are
# started separately and retain their own scheduling. Other machines may need
# a different CPU list after checking their topology and allowed affinity.
SOCIAL_NAV_COMMISSIONING_CPU_LIST="${SOCIAL_NAV_COMMISSIONING_CPU_LIST:-0-15}"
SOCIAL_NAV_COMMISSIONING_ENVIRONMENT_HZ=7.5
SOCIAL_NAV_COMMISSIONING_WINDOW_M=18
