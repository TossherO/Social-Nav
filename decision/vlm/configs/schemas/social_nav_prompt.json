{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Social navigation response",
  "oneOf": [
    {"$ref": "#/$defs/REL"},
    {"$ref": "#/$defs/REL_FOLLOW"},
    {"$ref": "#/$defs/GOAL"}
  ],
  "$defs": {
    "pid": {"type": "integer", "minimum": 0, "maximum": 99},
    "group": {
      "type": "object", "additionalProperties": false,
      "required": ["m", "r", "k"],
      "properties": {
        "m": {"type": "array", "minItems": 2, "maxItems": 20, "uniqueItems": true, "items": {"$ref": "#/$defs/pid"}},
        "r": {"type": "string", "enum": ["w", "t", "q", "p", "o", "u"]},
        "k": {"type": "integer", "enum": [0, 1]}
      },
      "if": {"properties": {"k": {"const": 1}}},
      "then": {"properties": {"r": {"enum": ["q", "p"]}}}
    },
    "groups": {"type": "array", "maxItems": 10, "items": {"$ref": "#/$defs/group"}},
    "unknown": {"type": "array", "maxItems": 20, "uniqueItems": true, "items": {"$ref": "#/$defs/pid"}},
    "REL": {
      "type": "object", "additionalProperties": false,
      "required": ["g", "u"],
      "properties": {"g": {"$ref": "#/$defs/groups"}, "u": {"$ref": "#/$defs/unknown"}}
    },
    "REL_FOLLOW": {
      "type": "object", "additionalProperties": false,
      "required": ["g", "u", "id", "s"],
      "properties": {
        "g": {"$ref": "#/$defs/groups"}, "u": {"$ref": "#/$defs/unknown"},
        "id": {"type": "integer", "minimum": -1, "maximum": 99},
        "s": {"type": "string", "enum": ["v", "o", "a", "l", "n"]}
      },
      "if": {"properties": {"s": {"enum": ["v", "o"]}}},
      "then": {"properties": {"id": {"minimum": 0}}},
      "else": {"properties": {"id": {"const": -1}}}
    },
    "GOAL": {
      "type": "object", "additionalProperties": false,
      "required": ["p", "s"],
      "properties": {
        "p": {"type": "integer", "minimum": -1, "maximum": 7},
        "s": {"type": "string", "enum": ["v", "n", "u"]}
      },
      "if": {"properties": {"s": {"const": "v"}}},
      "then": {"properties": {"p": {"minimum": 0}}},
      "else": {"properties": {"p": {"const": -1}}}
    }
  }
}
