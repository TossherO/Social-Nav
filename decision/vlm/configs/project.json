{
  "model": {
    "path": "models/Qwen3.8-27B-FP8",
    "served_name": "qwen3.8-27b-fp8",
    "frozen": true,
    "finetuning": false
  },
  "deployment": {
    "backend": "sglang",
    "mode": "self_hosted_native_conda",
    "entrypoint": "decision/vlm/deployment/start_server.sh",
    "host": "127.0.0.1",
    "port": 30000
  },
  "local_inference": {
    "device_map": "balanced",
    "max_memory_gib": 20,
    "context_length": 8192,
    "seed": 0
  },
  "inference": {
    "offline_backend": "sglang",
    "period_s": 2,
    "rate_hz": 0.5,
    "deadline_s": 2,
    "thinking": false,
    "temperature": 0,
    "max_tokens": 1024,
    "max_in_flight": 1,
    "automatic_retries": 0,
    "response_constraint": "json-schema"
  },
  "tasks": {
    "groups": {
      "prompt": "decision/vlm/configs/prompts/wheelchair_t1_groups.txt",
      "response": "activity_groups"
    },
    "appearance": {
      "prompt": "decision/vlm/configs/prompts/wheelchair_t2_appearance.txt",
      "response": "id_match"
    },
    "follow": {
      "prompt": "decision/vlm/configs/prompts/wheelchair_t2_follow.txt",
      "response": "id_state",
      "visual_memory_s": 4.5
    },
    "seating": {
      "prompt": "decision/vlm/configs/prompts/wheelchair_t3_seating.txt",
      "window_prompt": "decision/vlm/configs/prompts/wheelchair_t3_seating_window.txt",
      "window_extent_m": [-4.0, 4.0, -4.0, 4.0],
      "geometry_policy": "decision/vlm/configs/seating_geometry.json",
      "adjustment_prompt": "decision/vlm/configs/prompts/wheelchair_t3_seating_adjustment.txt",
      "adjustment_gate": {"distance_m": 0.15, "heading_deg": 15.0},
      "response": "candidate_selection",
      "max_tokens": 128
    }
  }
}
