<launch>
  <arg name="mode" default="mapping"/>
  <arg name="map_dir" default=""/>
  <arg name="run_dir"/>
  <arg name="initial_pose" default="[0,0,0,0,0,0]"/>
  <arg name="use_sim_time" default="false"/>
  <arg name="rviz" default="false"/>
  <arg name="visualize" default="$(arg rviz)"/>
  <arg name="keep_details" default="false"/>
  <arg name="loop_closure" default="true"/>
  <arg name="start_frontend" default="true"/>
  <arg name="wait_for_initial_pose" default="false"/>
  <arg name="assume_stationary" default="false"/>
  <arg name="environment" default="false"/>
  <arg name="record_environment_scans" default="false"/>
  <arg name="scene" default="false"/>
  <arg name="scene_people" default="false"/>
  <arg name="prior_map" default=""/>
  <arg name="static_map" default="$(arg prior_map)"/>
  <arg name="association_coverage" default=""/>
  <arg name="allow_local_only" default="false"/>
  <arg name="environment_config" default="$(dirname)/../../environment/configs/environment.yaml"/>
  <arg name="environment_backend" default=""/>
  <arg name="lidar_imu_calibration" default="$(dirname)/../../sensors/calibration/lidar_imu.yaml"/>
  <arg name="rviz_config" default="$(eval 'odometry.rviz' if arg('mode') == 'odometry' else 'roll.rviz')"/>
  <rosparam command="load" file="$(dirname)/../configs/fast_lio.yaml"/>
  <rosparam command="load" file="$(dirname)/../configs/roll.yaml"/>
  <rosparam command="load" file="$(dirname)/../configs/$(arg mode).yaml"/>
  <!-- Match the direct reader's zero default rather than reuse a prior master's offset. -->
  <param name="common/imu_time_offset" value="0.0"/>
  <param name="common/time_sync_en" value="false"/>
  <rosparam command="load" file="$(arg lidar_imu_calibration)"/>
  <!-- CUDA numerics belong to the direct runtime; this diagnostic stays CPU. -->
  <param name="matching_backend" value="cpu"/>
  <param name="deskew_backend" value="cpu"/>
  <param name="linearization_backend" value="cpu"/>
  <param name="roll/matchingBackend" value="cpu"/>
  <param name="stationary_imu/enabled" value="false"/>
  <group if="$(arg assume_stationary)">
    <rosparam command="load" file="$(dirname)/../configs/stationary_imu.yaml"/>
    <node pkg="social_nav_localization" type="stationary_imu_node" name="stationary_imu_input" output="screen" required="true" launch-prefix="/usr/bin/python3">
      <env name="SOCIAL_NAV_ROOT" value="$(dirname)/../../.."/>
    </node>
  </group>
  <param name="use_sim_time" value="$(arg use_sim_time)"/>
  <param name="roll/localizationMode" value="$(eval arg('mode') == 'localization')"/>
  <param name="roll/waitForInitialPose" value="$(arg wait_for_initial_pose)"/>
  <param name="roll/saveKeyframeMap" value="$(eval arg('mode') == 'mapping')"/>
  <param name="roll/savePCD" value="$(eval arg('mode') == 'mapping')"/>
  <param name="roll/saveKeyframeMapDirectory" value="$(arg map_dir)/keyframes"/>
  <param name="roll/log_dir" value="$(arg run_dir)"/>
  <param name="roll/writeDetails" value="$(arg keep_details)"/>
  <param name="odometry/writeDetails" value="$(arg keep_details)"/>
  <param name="log_dir" value="$(arg run_dir)"/>
  <rosparam param="roll/initialGuess" subst_value="true">$(arg initial_pose)</rosparam>
  <group if="$(eval arg('mode') == 'localization')">
    <param name="roll/loopClosureEnableFlag" value="false"/>
  </group>
  <group if="$(eval arg('mode') == 'mapping')">
    <param name="roll/loopClosureEnableFlag" value="$(arg loop_closure)"/>
  </group>
  <group if="$(eval arg('mode') == 'odometry')">
    <param name="publish/scan_publish_en" value="$(arg visualize)"/>
    <param name="odometry/visualize" value="$(arg visualize)"/>
  </group>
  <!-- Explicit roles also reset parameters left by a previous live task. -->
  <param name="odometry/publish_state" value="$(eval arg('mode') == 'odometry')"/>
  <param name="frontend/publish_state" value="$(arg environment)"/>
  <param name="odometry/state_topic" value="$(eval '/localization/frontend_state' if arg('environment') else '/localization/state')"/>
  <param name="odometry/publish_state_tf" value="$(eval not arg('environment'))"/>
  <param name="roll/localizationStateTopic" value="$(eval '/localization/map_state' if arg('environment') else '/localization/state')"/>
  <param name="roll/publishLocalizationTF" value="$(eval not arg('environment'))"/>
  <param name="roll/coverageGateEnabled" value="$(eval bool(arg('association_coverage')))"/>
  <group if="$(eval bool(arg('association_coverage')))">
    <rosparam command="load" file="$(arg association_coverage)" ns="roll/localization_coverage"/>
  </group>
  <group if="$(arg environment)">
    <param name="publish/lidar_scan_en" value="true"/>
    <node pkg="social_nav_localization" type="localization_context" name="localization_context" output="screen" required="true">
      <env name="SOCIAL_NAV_ROOT" value="$(dirname)/../../.."/>
      <param name="mode" value="$(arg mode)"/>
      <param name="map_dir" value="$(arg map_dir)"/>
      <param name="allow_local_only" value="$(arg allow_local_only)"/>
      <param name="config" value="$(arg environment_config)"/>
      <param name="coverage" type="str" value="$(arg association_coverage)"/>
      <param name="event_log" type="str" value="$(eval arg('run_dir') + '/context_events.jsonl' if arg('keep_details') else '')"/>
    </node>
    <node pkg="social_nav_environment" type="environment_node" name="environment" output="screen" required="true">
      <env name="SOCIAL_NAV_ROOT" value="$(dirname)/../../.."/>
      <param name="config" value="$(arg environment_config)"/>
      <param name="backend" value="$(arg environment_backend)" type="str"/>
      <param name="output" value="$(arg run_dir)/environment"/>
      <param name="record_scans" value="$(arg record_environment_scans)"/>
      <param name="people_enabled" value="$(arg scene_people)"/>
    </node>
    <node if="$(arg scene)" pkg="social_nav_environment" type="perception_scene" name="perception_scene" output="screen" required="true">
      <env name="SOCIAL_NAV_ROOT" value="$(dirname)/../../.."/>
      <param name="config" value="$(arg environment_config)"/>
      <param name="output" value="$(arg run_dir)/scene"/>
      <param name="people_enabled" value="$(arg scene_people)"/>
      <param name="static_map" type="str" value="$(arg static_map)"/>
      <param name="map_dir" type="str" value="$(arg map_dir)"/>
    </node>
  </group>
  <include if="$(arg start_frontend)" file="$(dirname)/frontend.launch">
    <arg name="with_roll" value="$(eval arg('mode') != 'odometry')"/>
  </include>
  <group unless="$(eval arg('mode') == 'odometry')">
    <node pkg="roll" type="roll_mapOptmization" name="roll_mapOptmization" output="screen" required="true"/>
  </group>
  <group if="$(arg rviz)">
    <include file="$(dirname)/../../detection_tracking/ros/launch/visualization.launch">
      <arg name="mode" value="localization"/>
      <arg name="localization_source" value="$(eval ('fast_lio' if arg('mode') == 'odometry' else 'roll_fast_lio') + ('_stationary_assumption' if arg('assume_stationary') else ''))"/>
    </include>
    <node pkg="rviz" type="rviz" name="localization_rviz" args="-d $(dirname)/../../visualization/configs/$(arg rviz_config)"/>
  </group>
</launch>
