<launch>
  <!-- Launch file for velodyne16 VLP-16 LiDAR -->

    <arg name="rviz" default="true" />

    <rosparam command="load" file="$(find fast_lio)/config/dataset_sw.yaml" />

    <node pkg="fast_lio" type="fastlio_mapping" name="laserMapping" output="screen"/> 

   <!-- <node  pkg="velodyne_pointcloud" type="transform_node" name="transform_node_16">
      <param name="calibration" value="$(find velodyne_pointcloud)/params/VLP16db.yaml"/>
      <param name="model" value="VLP16"/>
      <remap from ="/velodyne_packets" to ="/velodyne/front/velodyne_packets"/>
   </node> -->

    <group if="$(arg rviz)">
    <node launch-prefix="nice" pkg="rviz" type="rviz" name="rviz" args="-d $(find fast_lio)/rviz_cfg/loam_livox.rviz" />
    </group>

</launch>