<launch>

    <arg name="project" default="roll"/>
    <param name="use_sim_time" value="false" /> 
    <!-- Parameters -->
    <rosparam file="$(find roll)/config/params_jetson_sw_loc3.yaml" command="load" />
    <!--- LOAM -->
    <node pkg="$(arg project)" type="$(arg project)_scanRegistration"     name="$(arg project)_scanRegistration"      output="screen"     required="true"/>

    <node pkg="$(arg project)" 
        type="$(arg project)_mapOptmization"      
        name="$(arg project)_mapOptmization"   
        output="screen"     
        required="true"/>
       
    <include file="$(find fast_lio)/launch/mapping_jetson.launch" />

    <param name="robot_description" command="$(find xacro)/xacro $(find roll)/launch/include/config/robot_jetson.urdf.xacro --inorder" />
    <node name="robot_state_publisher" pkg="robot_state_publisher" type="robot_state_publisher" respawn="true"/>

    <node pkg="tf" type="static_transform_publisher" name="map2odom" args="0 0 0 0 0 0 /map /odom 100" />

        <!--- Run Rviz-->
    <!---include file="$(find roll)/launch/include/module_rviz.launch" /-->
</launch>
