<launch>
    <!-- setting it before roslaunch,this way these args can be overwritten by bash file -->
    <arg name="project" default="roll"/>
    <arg name="output_place" default="screen"/>
    <arg name="rviz" default="true"/>

    <param name="use_sim_time" value="true" /> 

    <node pkg="tf" type="static_transform_publisher" name="map2odom" args="0 0 0 0 0 0 /map /odom 100" /> 
    <!-- Parameters -->
    <rosparam file="$(find roll)/config/params_nclt_loc.yaml" command="load"/>
        
    <node pkg="$(arg project)" type="$(arg project)_scanRegistration"     name="$(arg project)_scanRegistration"      output="$(arg output_place)"    required="true"/>
    <node pkg="$(arg project)" type="$(arg project)_mapOptmization"      name="$(arg project)_mapOptmization"       output="$(arg output_place)"     required="true"/>
       
    <include file="$(find fast_lio)/launch/mapping_nclt.launch">
        <arg name="rviz" value="$(arg rviz)"/>
    </include>
    
    <!--- Robot State TF -->
    <include file="$(find roll)/launch/include/module_robot_state_publisher.launch" />

    <!--- Run Navsat -->
    <!-- <include file="$(find roll)/launch/include/module_navsat.launch" /> -->

    <!--- Run Rviz-->
    <group if="$(arg rviz)">
    <include file="$(find roll)/launch/include/module_rviz.launch" />
    </group>
</launch>
