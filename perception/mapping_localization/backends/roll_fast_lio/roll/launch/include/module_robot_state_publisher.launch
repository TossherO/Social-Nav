<launch>

	<arg name="project" default="roll"/>

    <param name="robot_description" command="$(find xacro)/xacro $(find roll)/launch/include/config/robot_jetson.urdf.xacro --inorder" />
    <node name="robot_state_publisher" pkg="robot_state_publisher" type="robot_state_publisher" respawn="true"/>
    
  
</launch>
