<?xml version="1.0"?>
<robot name="lio" xmlns:xacro="http://tixiaoshan.github.io/">
  <xacro:property name="PI" value="3.1415926535897931" />
  
  <!-- 2d and 3d lidar foot height: from ground: 0.2 m -->

  <link name="lidar_footprint"></link>

  <link name="base_footprint"></link>
  <joint name="lidar_joint" type="fixed">
    <parent link="lidar_footprint"/>
    <child link="base_footprint" />
    <origin xyz="-0.67 -0.33 0" rpy="0 0 0" /> 
  </joint>
 
  <link name="rslidar"></link>
  <joint name="lidar_joint2" type="fixed">
    <parent link="lidar_footprint"/>
    <child link="rslidar" />
    <origin xyz="0 0 0" rpy="0 0 0" /> 
  </joint>
  <link name="base_link"></link>
    <!-- velodyne height from baselink: 1.43m -->
  <joint name="base_link_joint" type="fixed">
    <parent link="rslidar"/>
    <!--<parent link="base_footprint"/>-->
    <child link="base_link" />
    <origin xyz="-0.67 -0.33 0.2" rpy="0 0 0" />
  </joint>

  <!--roughly measured: laser center 0.8 ahead: use literally hand_eye_calib-->
  <link name="laser_link"></link>
  <joint name="laser_joint" type="fixed">
    <parent link="base_link"/>
    <child link="laser_link" />
    <origin xyz="0.67 0.33 -0.2" rpy="0 0 0" /> 
  </joint>

  <link name="camera_link"></link>
  <joint name="camera_joint" type="fixed">
    <parent link="base_link"/>
    <child link="camera_link" />
    <origin xyz="0.67 0.33 0.4" rpy="0 0 0" /> 
  </joint>


</robot>
