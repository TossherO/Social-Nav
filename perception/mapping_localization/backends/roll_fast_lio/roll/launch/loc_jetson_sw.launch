<launch>

    <arg name="project" default="roll"/>
    <param name="use_sim_time" value="false" /> 
    <!-- Parameters -->
    <rosparam file="$(find roll)/config/params_jetson_sw_loc.yaml" command="load" />
    <!--- LOAM -->
    <node pkg="$(arg project)" type="$(arg project)_scanRegistration"     name="$(arg project)_scanRegistration"      output="screen"     required="true"/>

    <node pkg="$(arg project)" 
        type="$(arg project)_mapOptmization"      
        name="$(arg project)_mapOptmization"   
        output="screen"     
        required="true"/>
    
    <!-- <node pkg="roll" 
        type="roll_mapOptmization_semi"      
        name="roll_mapOptmization_semi"   
        output="screen"     
        required="true"/> -->
       
    <include file="$(find fast_lio)/launch/mapping_jetson.launch" />

    <param name="robot_description" command="$(find xacro)/xacro $(find roll)/launch/include/config/robot_jetson.urdf.xacro --inorder" />
    <node name="robot_state_publisher" pkg="robot_state_publisher" type="robot_state_publisher" respawn="true"/>

    <node pkg="tf" type="static_transform_publisher" name="map2odom" args="0 0 0 0 0 0 /map /odom 100" />

    <!-- <node pkg="tf2_ros" type="static_transform_publisher" name="rslidar2camera_color_optical_frame"
      args="0.06606787 -0.00513684 -0.12207122  -1.5341449046125326 0.01102578270909027 -1.5143400456740843 rslidar camera_color_optical_frame   " />
    <node pkg="tf2_ros" type="static_transform_publisher" name="lidar_link2rslidar"
      args="0 0 0 0 0 0 lidar_link rslidar " />

    <node pkg="tf2_ros" type="static_transform_publisher" name="rslidar2base_link"
      args="-0.67 -0.33 0 0 0 0 rslidar base_link " /> -->
    

        <!--- Run Rviz-->
     <include file="$(find roll)/launch/include/module_rviz.launch" />
</launch>
