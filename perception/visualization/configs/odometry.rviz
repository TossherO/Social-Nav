Panels:
  - Class: rviz/Displays
    Name: Displays
  - Class: rviz/Views
    Name: Views
Visualization Manager:
  Class: ""
  Global Options:
    Fixed Frame: odom
    Background Color: 35; 35; 35
  Displays:
    - Class: rviz/Grid
      Name: Grid
      Enabled: true
      Plane Cell Count: 80
      Cell Size: 1
    - Class: rviz/PointCloud2
      Name: Current scan (observation-bound)
      Enabled: true
      Topic: /perception/visualization/scan
      Queue Size: 2
      Decay Time: 0
      Style: Points
      Size (Pixels): 3
      Color Transformer: FlatColor
      Color: 90; 210; 235
    - Class: rviz/PointCloud2
      Name: Recent scans
      Enabled: false
      Topic: /cloud_registered
      Queue Size: 2
      Decay Time: 5
      Style: Points
      Size (Pixels): 2
      Color Transformer: AxisColor
      Axis: Z
    - Class: rviz/Path
      Name: Local trajectory
      Enabled: true
      Topic: /localization/path
      Color: 255; 110; 40
    - Class: rviz/MarkerArray
      Name: People detections and tracks
      Enabled: true
      Marker Topic: /perception/people/markers
      Queue Size: 5
    - Class: rviz/Image
      Name: Matched RGB
      Enabled: false
      Image Topic: /perception/people/rgb
      Queue Size: 1
      Transport Hint: raw
    - Class: rviz/TF
      Name: TF
      Enabled: true
  Tools:
    - Class: rviz/Interact
    - Class: rviz/MoveCamera
  Views:
    Current:
      Class: rviz/Orbit
      Distance: 30
      Pitch: 1.25
      Yaw: 0.8
Window Geometry:
  Width: 1280
  Height: 850
