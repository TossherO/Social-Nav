Panels:
  - Class: social_nav_rviz/SessionPanel
    Name: Social-Nav session
  - Class: rviz/Displays
    Name: Displays
  - Class: rviz/Views
    Name: Views
Visualization Manager:
  Class: ""
  Global Options:
    Background Color: 38; 42; 48
    Fixed Frame: odom
    Frame Rate: 20
  Displays:
    - Class: rviz/PointCloud2
      Name: Current scan
      Enabled: true
      Topic: /social_nav_runtime_view/scan
      Queue Size: 1
      Style: Points
      Size (Pixels): 3
      Color Transformer: AxisColor
      Axis: Z
      Decay Time: 0
    - Class: rviz/MarkerArray
      Name: People
      Enabled: true
      Marker Topic: /social_nav_runtime_view/people
      Queue Size: 1
    - Class: rviz/PointCloud2
      Name: Navigation basemap
      Enabled: true
      Topic: /social_nav_runtime_view/navigation_basemap
      Queue Size: 1
      Style: Squares
      Size (m): 0.1
      Color Transformer: RGB8
      Alpha: 1
      Decay Time: 0
    - Class: rviz/PointCloud2
      Name: Static map
      Enabled: true
      Topic: /social_nav_runtime_view/static_basemap
      Queue Size: 1
      Style: Squares
      Size (m): 0.1
      Color Transformer: RGB8
      Alpha: 0.9
      Decay Time: 0
    - Class: rviz/PointCloud2
      Name: Navigation search grid
      Enabled: false
      Topic: /social_nav_runtime_view/reference_search_map
      Queue Size: 1
      Style: Squares
      Size (m): 0.1
      Color Transformer: RGB8
      Alpha: 1
      Decay Time: 0
    - Class: rviz/PointCloud2
      Name: Local map
      Enabled: false
      Topic: /social_nav_runtime_view/local_basemap
      Queue Size: 1
      Style: Squares
      Size (m): 0.1
      Color Transformer: RGB8
      Alpha: 1
      Decay Time: 0
    - Class: rviz/MarkerArray
      Name: Terrain paths, vehicle and planning status
      Enabled: true
      Marker Topic: /social_nav_runtime_view/navigation
      Queue Size: 1
    - Class: rviz/Image
      Name: RGB
      Enabled: true
      Image Topic: /social_nav_runtime_view/rgb
      Queue Size: 1
  Tools:
    - Class: rviz/MoveCamera
    - Class: rviz/Interact
    - Class: rviz/FocusCamera
  Views:
    Current:
      Class: rviz/Orbit
      Target Frame: <Fixed Frame>
      Distance: 18
      Pitch: 0.8
      Yaw: 0.8
      Focal Point: {X: 0, Y: 0, Z: 0}
Window Geometry:
  # Session, Displays and Views share the upper left dock above RGB.
  QMainWindow State: 
  Width: 1000
  Height: 720
