Preferences:
  PromptSaveOnExit: false
Panels:
  - Class: rviz/Displays
    Name: Displays
  - Class: rviz/Views
    Name: Views
Visualization Manager:
  Class: ""
  Global Options:
    Fixed Frame: odom
    Background Color: 35; 35; 35
  Displays:
    - Class: rviz/Grid
      Name: Grid
      Enabled: true
      Plane Cell Count: 40
      Cell Size: 1
    - Class: rviz/PointCloud2
      Name: Current scan (observation-bound)
      Enabled: true
      Topic: /perception/visualization/scan
      Queue Size: 1
      Decay Time: 0
      Style: Points
      Size (Pixels): 2
      Color Transformer: FlatColor
      Color: 140; 140; 160
    - Class: rviz/MarkerArray
      Name: People detections and tracks
      Enabled: true
      Marker Topic: /perception/people/markers
      Queue Size: 5
    - Class: rviz/Image
      Name: Matched RGB
      Enabled: true
      Image Topic: /perception/people/rgb
      Queue Size: 1
      Transport Hint: raw
  Tools:
    - Class: rviz/Interact
    - Class: rviz/MoveCamera
  Views:
    Current:
      Class: rviz/Orbit
      Distance: 20
      Pitch: 1.2
      Yaw: 0.8
Window Geometry:
  Width: 1280
  Height: 850
