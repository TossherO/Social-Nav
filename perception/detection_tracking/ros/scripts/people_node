#!/usr/bin/env python3
"""Catkin entry; launch supplies the repository root, never an external detector source."""
import os
import sys
from pathlib import Path

root = os.environ.get('SOCIAL_NAV_ROOT')
if not root:
    raise SystemExit('Set SOCIAL_NAV_ROOT to the project checkout (provided by people.launch)')
sys.path.insert(0, str(Path(root).resolve()))
from perception.detection_tracking.ros.node import main

main()
