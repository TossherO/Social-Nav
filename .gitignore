# Local datasets/models/results are retained on disk, not source code.
/data/
/models/
/outputs/
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
*.partial.mp4

# Local Python environments.
.venv/
venv/

# Local credentials and configuration; keep reusable examples tracked.
**/*.local.json
.env
.env.*
!.env.example
!.env.sample
!.env.template
/.aws/

# Machine-specific environment notes; keep credentials out of this document.
/ENVIRONMENT.local.md
/docs/archive/*.local.md

# Operating system and editor temporary files.
.DS_Store
Thumbs.db
Desktop.ini
*.swp
*.swo
*~

# The copied detector retains source, never training resources/build artifacts.
/perception/detection_tracking/training/simpledet3d/data
/perception/detection_tracking/training/simpledet3d/output/
/perception/detection_tracking/training/simpledet3d/build/
/perception/detection_tracking/training/simpledet3d/**/*.so
/perception/detection_tracking/training/simpledet3d/*.egg-info/
